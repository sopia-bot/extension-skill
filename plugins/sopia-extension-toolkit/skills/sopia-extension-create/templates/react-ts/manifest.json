{
  "name": "{{EXT_NAME}}",
  "version": "{{VERSION}}",
  "description": "{{DESCRIPTION}}",
  "main": "dist/index.js",
  "author": "{{AUTHOR}}",
  "renderer": {
    "url": "index.html",
    "baseUrl": "renderer/dist"
  },
  "files": [
    "dist/",
    "renderer/dist/"
  ],
  "schema": {
    "settings": {
      "commandPrefix": {
        "type": "string",
        "title": "명령어 접두사",
        "description": "채팅 명령어 앞에 붙는 문자열입니다.",
        "default": "!"
      },
      "welcomeMessage": {
        "type": "string",
        "title": "환영 메시지",
        "description": "{nickname}은 입장한 청취자의 닉네임으로 바뀝니다.",
        "default": "환영합니다, {nickname}님!"
      },
      "enableWelcome": {
        "type": "boolean",
        "title": "입장 인사 활성화",
        "description": "청취자가 입장하면 환영 메시지를 보냅니다.",
        "default": true
      }
    },
    "stats": {
      "commandCount": {
        "type": "number",
        "title": "명령어 수",
        "description": "정상 처리된 명령어의 누적 횟수입니다."
      }
    }
  },
  "permissions": {
    "sopia": [
      {
        "scope": "read:lives",
        "reason": "채팅과 입장 이벤트를 수신합니다."
      },
      {
        "scope": "write:lives",
        "reason": "명령어 응답과 입장 인사를 채팅으로 전송합니다."
      }
    ]
  },
  "_id": "{{EXT_ID}}"
}
