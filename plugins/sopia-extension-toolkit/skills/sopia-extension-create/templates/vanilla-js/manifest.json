{
  "name": "{{EXT_NAME}}",
  "version": "{{VERSION}}",
  "description": "{{DESCRIPTION}}",
  "main": "index.js",
  "author": "{{AUTHOR}}",
  "renderer": {
    "url": "index.html",
    "baseUrl": "renderer"
  },
  "schema": {
    "settings": {
      "enableWelcome": {
        "type": "boolean",
        "title": "입장 인사 활성화",
        "description": "청취자가 입장하면 환영 메시지를 보냅니다.",
        "default": false
      },
      "welcomeMessage": {
        "type": "string",
        "title": "환영 메시지",
        "description": "{nickname}은 입장한 청취자의 닉네임으로 바뀝니다.",
        "default": "환영합니다, {nickname}님!"
      }
    }
  },
  "permissions": {
    "sopia": [
      {
        "scope": "read:lives",
        "reason": "채팅과 입장 이벤트를 수신합니다."
      },
      {
        "scope": "write:lives",
        "reason": "명령어 응답과 입장 인사를 채팅으로 전송합니다."
      }
    ]
  },
  "_id": "{{EXT_ID}}"
}
